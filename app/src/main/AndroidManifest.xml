<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Temporizador de apagado: sigue contando aunque Locky esté cerrado -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Permisos que trae el motor de VPN y Locky no necesita.
         (RECEIVE_BOOT_COMPLETED NO se saca: el motor lo necesita para su tarea de
         "mantener la VPN viva"; sin ese permiso Android tira error y la VPN se cae.) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove" />

    <!-- Funciona en TV y también en celulares/tablets -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Android 11+ exige declarar qué otras apps queremos "ver" -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_locky"
        android:banner="@drawable/banner_locky"
        android:theme="@style/Theme.Locky"
        android:networkSecurityConfig="@xml/network_security_config"
        android:name=".LockyApplication"
        android:allowBackup="false"
        tools:replace="android:name,android:label,android:icon,android:theme,android:allowBackup"
        tools:remove="android:roundIcon,android:appCategory">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".VpnTimerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Temporizador que apaga la VPN a la hora elegida por el usuario" />
        </service>

        <!-- ===== Motor de VPN integrado =====
             El motor trae piezas pensadas para la app OpenVPN for Android completa.
             Las sacamos: así ninguna otra app puede manejar la VPN de Locky,
             y la VPN no se prende sola al encender el TV. -->
        <service android:name="de.blinkt.openvpn.api.ExternalOpenVPNService" tools:node="remove" />
        <activity android:name="de.blinkt.openvpn.api.GrantPermissionsActivity" tools:node="remove" />
        <activity android:name="de.blinkt.openvpn.api.ConfirmDialog" tools:node="remove" />
        <activity android:name="de.blinkt.openvpn.api.RemoteAction" tools:node="remove" />
        <activity-alias android:name="de.blinkt.openvpn.api.ConnectVPN" tools:node="remove" />
        <activity-alias android:name="de.blinkt.openvpn.api.DisconnectVPN" tools:node="remove" />
        <activity-alias android:name="de.blinkt.openvpn.api.PauseVPN" tools:node="remove" />
        <activity-alias android:name="de.blinkt.openvpn.api.ResumeVPN" tools:node="remove" />
        <activity-alias android:name="de.blinkt.openvpn.api.SetDefaultVPN" tools:node="remove" />
        <receiver android:name="de.blinkt.openvpn.OnBootReceiver" tools:node="remove" />
        <receiver android:name="core.GetRestrictionReceiver" tools:node="remove" />
        <meta-data android:name="android.content.APP_RESTRICTIONS" tools:node="remove" />
        <!-- Esta sí la usa el motor por dentro, pero ninguna otra app tiene que poder abrirla -->
        <activity android:name="de.blinkt.openvpn.LaunchVPN"
            android:exported="false" tools:replace="android:exported" />
    </application>
</manifest>
